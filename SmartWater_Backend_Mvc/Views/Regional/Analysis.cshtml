@{
    ViewData["Title"] = "Regional Analysis";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <input id="searchInput" class="form-control" placeholder="Search regions..." />
        </div>
        <div class="col-md-3">
            <select id="statusFilter" class="form-select">
                <option value="">All</option>
                <option value="ok">OK</option>
                <option value="alert">Alert</option>
                <option value="overdue">Overdue</option>
            </select>
        </div>
        <div class="col-md-3">
            <button id="searchBtn" class="btn btn-primary">Search</button>
        </div>
    </div>

    <div class="accordion" id="regionsAccordion">
        <!-- Regions will be loaded dynamically -->
    </div>
</div>

<script>
    async function loadRegions() {
        const search = document.getElementById('searchInput').value;
        const status = document.getElementById('statusFilter').value;
        const q = new URLSearchParams();
        if (search) q.append('search', search);
        if (status) q.append('status', status);

        const resp = await fetch('/Clients/Regional/GetRegions?' + q.toString());
        const regions = await resp.json();
        const acc = document.getElementById('regionsAccordion');
        acc.innerHTML = '';
        regions.forEach((r, idx) => {
            const id = 'region-' + idx;
            const header = document.createElement('h2');
            header.className = 'accordion-header';
            header.id = 'heading-' + id;

            const button = document.createElement('button');
            button.className = 'accordion-button collapsed';
            button.type = 'button';
            button.setAttribute('data-bs-toggle', 'collapse');
            button.setAttribute('data-bs-target', '#collapse-' + id);
            button.setAttribute('aria-expanded', 'false');
            button.setAttribute('aria-controls', 'collapse-' + id);
            button.innerText = r.regionName + ' — Outstanding: ' + (r.outstandingCost ?? 'N/A');

            header.appendChild(button);

            const collapse = document.createElement('div');
            collapse.id = 'collapse-' + id;
            collapse.className = 'accordion-collapse collapse';
            collapse.setAttribute('aria-labelledby', 'heading-' + id);
            collapse.setAttribute('data-bs-parent', '#regionsAccordion');

            const body = document.createElement('div');
            body.className = 'accordion-body';
            body.innerHTML = '<div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>';

            collapse.appendChild(body);

            const item = document.createElement('div');
            item.className = 'accordion-item';
            item.appendChild(header);
            item.appendChild(collapse);
            acc.appendChild(item);

            // attach event to load subregions when expanded
            collapse.addEventListener('show.bs.collapse', async () => {
                const subResp = await fetch('/Clients/Regional/GetSubRegions?regionId=' + encodeURIComponent(r.regionId));
                const subs = await subResp.json();
                const tbl = document.createElement('table');
                tbl.className = 'table table-sm table-bordered';
                tbl.innerHTML = '<thead><tr><th>Sub-Region Name</th><th>Water Dispatched</th><th>Variance</th><th>Alert Status</th></tr></thead>';
                const tb = document.createElement('tbody');
                subs.forEach(s => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `<td>${s.subRegionName}</td><td>${s.waterDispatched}</td><td>${s.variance}</td><td>${s.alertStatus}</td>`;
                    tb.appendChild(tr);
                });
                tbl.appendChild(tb);
                body.innerHTML = '';
                body.appendChild(tbl);
            });
        });
    }

    document.getElementById('searchBtn').addEventListener('click', loadRegions);
    document.getElementById('searchInput').addEventListener('keyup', (e) => { if (e.key === 'Enter') loadRegions(); });

    // Initial load
    loadRegions();
</script>
