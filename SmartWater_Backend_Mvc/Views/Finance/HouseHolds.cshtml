@using System.Globalization
@model IEnumerable<SmartWater_Backend_Mvc.Models.HouseHold>

@{
    ViewData["Title"] = "Household Payments";
    Layout = "_FinanceLayout";

    // Dynamic processing variables
    double totalExpected = Model.Sum(x => x.Cost);
    double totalOutstanding = Model.Sum(x => x.Other_OutStandingCost);
    double totalActual = totalExpected - totalOutstanding;
}

<div style="display:flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 20px;">
    <h1 style="color:white; margin:10px; font-size: 24px;">Water Payment History for: @DateTime.Now.Date.ToString("yyyy MMMM dd")</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Engineer" asp-action="HouseholdPredictions" class="btn fw-bold shadow-sm" style="background-color: #ff3366; color: #fff; border-radius: 8px; padding: 10px 20px; text-decoration:none; transition: all 0.2s;">
            🔮 View Future Household Consumption
        </a>
        <a asp-controller="Gemini" asp-action="DropWiseAi" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; transition: all 0.2s;">
            ✨ Chat With Drop Wise Ai
        </a>
    </div>
</div>

<!-- FINANCIAL CARD METRIC SUMMARIES -->
<div class="row g-3 mx-2 mb-3 text-white">
    <div class="col-md-4">
        <div class="p-3 rounded text-center" style="background-color: #1e1e24; border-left: 5px solid #00f0ff; border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333;">
            <small class="text-white-50 text-uppercase d-block fw-bold mb-1">Total Expected Revenue</small>
            <h3 class="fw-bold mb-0 text-info">@totalExpected.ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 rounded text-center" style="background-color: #28a745; border-left: 5px solid #28a745; border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333;">
            <small class="text-white-50 text-uppercase d-block fw-bold mb-1">Total Actual Collected</small>
            <h3 class="fw-bold mb-0 text-success">@totalActual.ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3 rounded text-center" style="background-color: #1e1e24; border-left: 5px solid #ff3366; border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333;">
            <small class="text-white-50 text-uppercase d-block fw-bold mb-1">Total Outstanding Debt</small>
            <h3 class="fw-bold mb-0 text-danger">@totalOutstanding.ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</h3>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-3 m-3 p-3 rounded" style="background-color: #1e1e24; border: 1px solid #333;">
    <div>
        <input type="text" id="tableSearch" placeholder="Search Account No..." class="form-control"
               style="background-color: #121212; color: #fff; border: 1px solid #00f0ff; max-width: 250px;" />
    </div>
    <div>
        <select id="statusFilter" class="form-select" style="background-color: #121212; color: #fff; border: 1px solid #00f0ff;">
            <option value="all">All Households</option>
            <option value="outstanding">Has Outstanding Fees</option>
            <option value="paid">Paid Status</option>
        </select>
    </div>
    <div class="ms-auto d-flex align-items-center gap-3">
        <a asp-action="AdminDashboard" asp-controller="Admin" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 8px 16px;">
            Back To Dashboard
        </a>
        <button id="downloadBtn" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 8px 16px;">
            📥 Download Report
        </button>
        <span class="text-muted small" style="color: #aaa !important;width:200px;">
            *Note: You are downloading exactly what you are currently viewing.
        </span>
    </div>
</div>

<div style="height:100vh" class="table-responsive rounded shadow">
    <table id="reportsTable" style="margin:15px; border-radius:10px;" class="table table-dark table-hover mb-0">
        <thead style="border-bottom: 2px solid #00f0ff; margin:5px; background-color:#00f0ff;">
            <tr>
                <th scope="col">Account Number</th>
                <th scope="col">Sub-Region Location</th>
                <th scope="col">Water Received (kl)</th>
                <th scope="col">Usage Cost</th>
                <th scope="col">Outstanding Balance</th>
                <th scope="col">Payment Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var house in Model)
            {
                <tr class="household-row"
                    data-account="@house.Account_Number.ToLower()"
                    data-outstanding-cost="@house.Other_OutStandingCost"
                    data-status="@house.Status.ToLower()">
                    <td>@house.Account_Number</td>
                    <td>@house.SubRegion_Name</td>
                    <td>@house.Water_Received.ToString("F2")</td>
                    <td>@house.Cost.ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</td>
                    <td>@house.Other_OutStandingCost.ToString("C", CultureInfo.CreateSpecificCulture("en-ZA"))</td>
                    <td>
                        <span class="badge @(house.Status == "Paid" ? "bg-success" : "bg-danger")">
                            @house.Status
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchInput = document.getElementById("tableSearch");
        const statusFilter = document.getElementById("statusFilter");
        const rows = document.querySelectorAll(".household-row");
        const downloadBtn = document.getElementById("downloadBtn");

        function filterTable() {
            const searchText = searchInput.value.toLowerCase();
            const filterValue = statusFilter.value;

            rows.forEach(row => {
                const accountNum = row.getAttribute("data-account");
                const outstandingCost = parseFloat(row.getAttribute("data-outstanding-cost")) || 0;
                const statusValue = row.getAttribute("data-status");
                const matchesSearch = accountNum.includes(searchText);

                let matchesStatus = true;
                if (filterValue === "outstanding") {
                    matchesStatus = outstandingCost > 0 || statusValue === "outstanding";
                } else if (filterValue === "paid") {
                    matchesStatus = statusValue === "paid";
                }

                row.style.display = (matchesSearch && matchesStatus) ? "" : "none";
            });
        }

        searchInput.addEventListener("input", filterTable);
        statusFilter.addEventListener("change", filterTable);

        downloadBtn.addEventListener("click", function() {
            let csvContent = "";
            const table = document.getElementById("reportsTable");
            const headers = Array.from(table.querySelectorAll("thead th"))
                .map(th => `"${th.innerText.trim()}"`);

            csvContent += headers.join(",") + "\n";
            const visibleRows = Array.from(table.querySelectorAll("tbody tr")).filter(row => row.style.display !== "none");

            visibleRows.forEach(row => {
                const cells = Array.from(row.querySelectorAll("td"))
                    .map(cell => `"${cell.innerText.trim().replace(/"/g, '""')}"`);
                csvContent += cells.join(",") + "\n";
            });

            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", `Household_Payment_Report_${new Date().toISOString().slice(0, 10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    });
</script>
