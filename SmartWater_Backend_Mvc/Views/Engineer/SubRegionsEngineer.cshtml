@using System.Globalization
@model IEnumerable<SmartWater_Backend_Mvc.Models.SubRegion>

@{
    ViewData["Title"] = "Region Consumption";
    Layout = "_FinanceLayout";

   
    double totalDistributed = Model.Sum(x => x.Water_Sent);
    double totalUsed = Model.Sum(x => x.Water_Used);
    double totalOutstanding = totalDistributed - totalUsed;
    double totalFree = Model.Sum(x => x.FreeWater.HasValue ? x.FreeWater.Value : 0);
}

<div style="display:flex; flex-direction: row; justify-content: space-between; align-items: center; padding: 10px 20px;">
    <h1 style="color:white;margin:10px; font-size: 24px;">Water Consumption History for: @DateTime.Now.Date.ToString("yyyy MMMM dd")</h1>
    <div class="d-flex gap-2">
        <a asp-action="SubRegionsPredictions" class="btn fw-bold shadow-sm" style="background-color: #ff3366; color: #fff; border-radius: 8px; padding: 10px 20px; text-decoration:none; transition: all 0.2s;">
            🔮 View Future SubRegion Consumption
        </a>
        <a asp-controller="Gemini" asp-action="DropWiseAi" id="btnSumFinance" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; transition: all 0.2s;">
            ✨ Chat With Drop Wise Ai
        </a>
    </div>
</div>

<!-- ENGINEERING CARD METRIC SUMMARIES -->
<div class="row g-3 mx-2 mb-3 text-white">
    <div class="col-md-3">
        <div class="p-3 rounded text-center" style="background-color: #1e1e24; border-left: 5px solid #00f0ff; border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333;">
            <small class="text-white-50 text-uppercase d-block fw-bold mb-1">Total Distributed</small>
            <h3 class="fw-bold mb-0 text-info">@totalDistributed.ToString("F2") <span style="font-size:14px;">kl</span></h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 rounded text-center" style="background-color: #1e1e24; border-left: 5px solid #28a745; border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333;">
            <small class="text-white-50 text-uppercase d-block fw-bold mb-1">Total Used</small>
            <h3 class="fw-bold mb-0 text-success">@totalUsed.ToString("F2") <span style="font-size:14px;">kl</span></h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 rounded text-center" style="background-color: #1e1e24; border-left: 5px solid #ffcc00; border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333;">
            <small class="text-white-50 text-uppercase d-block fw-bold mb-1">Total Free Water</small>
            <h3 class="fw-bold mb-0 text-warning">@totalFree.ToString("F2") <span style="font-size:14px;">kl</span></h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 rounded text-center" style="background-color: #1e1e24; border-left: 5px solid #ff3366; border-top: 1px solid #333; border-right: 1px solid #333; border-bottom: 1px solid #333;">
            <small class="text-white-50 text-uppercase d-block fw-bold mb-1">Total Outstanding</small>
            <h3 class="fw-bold mb-0 text-danger">@totalOutstanding.ToString("F2") <span style="font-size:14px;">kl</span></h3>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-3 m-3 p-3 rounded" style="background-color: #1e1e24; border: 1px solid #333;">
    <div>
        <input type="text" id="tableSearch" placeholder="Search Sub-Region..." class="form-control"
               style="background-color: #121212; color: #fff; border: 1px solid #00f0ff; max-width: 250px;" />
    </div>

    <div>
        <select id="statusFilter" class="form-select" style="background-color: #121212; color: #fff; border: 1px solid #00f0ff;">
            <option value="all">All Sub-Regions</option>
            <option value="outstanding">Has Outstanding Water (>0)</option>
            <option value="high-leak">High Leak Probability (&gt; 15%)</option>
        </select>
    </div>
    <div class="ms-auto d-flex align-items-center gap-3">
       <a asp-action="AdminDashboard" asp-controller="Admin" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 8px 16px;">
            Back To Dashboard
        </a>
        <button id="downloadBtn" class="btn fw-bold" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 8px 16px;">
            📥 Download Report
        </button>
        <span class="text-muted small" style="color: #aaa !important;width:200px">
            *Note: You are downloading exactly what you are currently viewing.
        </span>
    </div>
</div>

<div style="height:100vh" class="table-responsive rounded shadow">
    <table id="reportsTable" style="margin:15px; border-radius:10px;" class="table table-dark table-hover mb-0">
        <thead style="border-bottom: 2px solid #00f0ff; margin:5px; background-color:#00f0ff;">
            <tr>
                <th scope="col">Sub-Region Name</th>
                <th scope="col">Disributed (kl)</th>
                <th scope="col">Used (kl)</th>
                <th scope="col">Outstanding (kl)</th>
                <th scope="col">Total Free Water (Kl)</th>
                <th scope="col">Daily Usage (kl)</th>
                <th scope="col">Night Usage (kl)</th>
                <th scope="col">Leak Probability</th>
                <th scope="col" class="no-export">Sub-Regions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var region in Model)
            {
                <tr class="region-row"
                    data-region="@region.SubRegion_Name.ToLower()"
                    data-outstanding-water="@region.Water_Thats_OutStanding"
                    data-leak-prob="@region.Leakage_Propability">

                    <td>@region.SubRegion_Name</td>
                    <td>@region.Water_Sent.ToString("F2")</td>
                    <td>@region.Water_Used.ToString("F2")</td>
                    <td>@totalOutstanding.ToString("F2")</td>
                    <td>@region.FreeWater.Value.ToString("F2")</td>
                    <td>@region.Daily_Usage.Value.ToString("F2")</td>
                    <td>@region.Night_Usage.Value.ToString("F2")</td>
                    <td>
                        <span class="fw-bold @(region.Leakage_Propability > 15 ? "text-danger" : "text-success")">
                            @region.Leakage_Propability.ToString("F2")%
                        </span>
                    </td>
                    <td class="no-export">
                        <a asp-action="EnginnerHouseHolds" asp-route-id="@region.SubRegion_Id" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">Households</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const searchInput = document.getElementById("tableSearch");
        const statusFilter = document.getElementById("statusFilter");
        const rows = document.querySelectorAll(".region-row");
        const downloadBtn = document.getElementById("downloadBtn");

        function filterTable() {
            const searchText = searchInput.value.toLowerCase();
            const filterValue = statusFilter.value;

            rows.forEach(row => {
                const regionName = row.getAttribute("data-region");
                const outstandingWater = parseFloat(row.getAttribute("data-outstanding-water")) || 0;
                const leakProb = parseFloat(row.getAttribute("data-leak-prob")) || 0;

                const matchesSearch = regionName.includes(searchText);

                let matchesStatus = true;
                if (filterValue === "outstanding") {
                    matchesStatus = outstandingWater > 0;
                } else if (filterValue === "high-leak") {
                    matchesStatus = leakProb > 15;
                }

                if (matchesSearch && matchesStatus) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        searchInput.addEventListener("input", filterTable);
        statusFilter.addEventListener("change", filterTable);

        downloadBtn.addEventListener("click", function() {
            let csvContent = "";
            const table = document.getElementById("reportsTable");
            const headers = Array.from(table.querySelectorAll("thead th"))
                .filter(th => !th.classList.contains("no-export"))
                .map(th => `"${th.innerText.trim()}"`);

            csvContent += headers.join(",") + "\n";
            const visibleRows = Array.from(table.querySelectorAll("tbody tr"))
                .filter(row => row.style.display !== "none");

            visibleRows.forEach(row => {
                const cells = Array.from(row.querySelectorAll("td"))
                    .filter(cell => !cell.classList.contains("no-export"))
                    .map(cell => {
                        let text = cell.innerText.trim().replace(/"/g, '""');
                        return `"${text}"`;
                    });
                csvContent += cells.join(",") + "\n";
            });

            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");

            link.setAttribute("href", url);
            link.setAttribute("download", `Region_Water_Consumption_Report_${new Date().toISOString().slice(0, 10)}.csv`);
            link.style.visibility = "hidden";

            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });
    });
</script>