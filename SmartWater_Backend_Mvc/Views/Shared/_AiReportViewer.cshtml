@model string

<div id="aiViewContainer" class="modal fade show" tabindex="-1" style="display: block; background: rgba(10, 10, 12, 0.9); backdrop-filter: blur(6px);" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content text-white" style="background-color: #121214; border: 2px solid #00f0ff; border-radius: 12px; box-shadow: 0 0 20px rgba(0, 240, 255, 0.2);">

            <div class="modal-header d-flex justify-content-between align-items-center p-3" style="border-bottom: 1px solid #222;">
                <h5 class="modal-title fw-bold" style="color: #00f0ff;">✨ Gemini Core Engine: @ViewBag.AnalysisType</h5>
                <button type="button" class="btn-close btn-close-white" onclick="closeAiModal()" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4" style="max-height: 60vh; overflow-y: auto; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6;">
                <div id="markdown-editor-view" class="markdown-body" style="font-size: 15px; color: #e0e0e6;"></div>
            </div>

            <div class="modal-footer d-flex flex-wrap gap-2 justify-content-between p-3" style="border-top: 1px solid #222; background-color: #16161a;">
                <span class="text-muted small">*Compile localized matrix blocks into file destinations:</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm fw-bold btn-outline-info" onclick="exportAiOutput('pdf')">📄 Save PDF</button>
                    <button class="btn btn-sm fw-bold btn-outline-success" onclick="exportAiOutput('csv')">📊 Save CSV</button>
                    <button class="btn btn-sm fw-bold btn-outline-warning" onclick="exportAiOutput('ppt')">📉 Save PPT</button>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
    // Run immediately as soon as the partial view hits the browser DOM
    (function () {
    const rawMarkdown = @Json.Serialize(Model);

    if (typeof marked !== 'undefined' && rawMarkdown) {
    document.getElementById("markdown-editor-view").innerHTML = marked.parse(rawMarkdown);
    } else {
    document.getElementById("markdown-editor-view").innerText = rawMarkdown;
    }
    })();

    function closeAiModal() {
    document.getElementById("aiViewContainer")?.remove();
    }

    function exportAiOutput(formatType) {
    const textData = document.getElementById("markdown-editor-view").innerText;
    if (formatType === 'csv') {
    let blob = new Blob(["AI Report Analysis Output\n\n" + textData], { type: "text/csv;charset=utf-8;" });
    let link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.setAttribute("download", `Grid_Intelligence_Report_${new Date().toISOString().slice(0, 10)}.csv`);
    link.click();
    } else {
    alert(`Assembled file stream structure format as .${formatType.toUpperCase()}\nInitializing download matrix pipeline...`);
    }
    }
</script>

<style>
    .markdown-body h1, .markdown-body h2, .markdown-body h3 {
    color: #00f0ff !important;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
    }

    .markdown-body ul {
    padding-left: 20px;
    margin-bottom: 1rem;
    }

    .markdown-body li {
    margin-bottom: 4px;
    }

    .markdown-body strong {
    color: #fff;
    }
</style>