<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartWater_Backend_Mvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/clerck.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartWater_Backend_Mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark" style="background-color: #111010; border-bottom: 2px solid #00f0ff; padding: 15px 20px;">
            <div class="container-fluid d-flex align-items-center justify-content-between">

                <a class="navbar-brand" style="color: #00f0ff; font-weight: 700; letter-spacing: 1px; font-size: 1.25rem; text-transform: uppercase;">
                    SmartWater System
                </a>

                <div class="collapse navbar-collapse justify-content-end">
                    <ul class="navbar-nav gap-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Clerk" asp-action="Regions"
                               style="color: #ffffff; font-weight: 500; transition: color 0.3s ease; padding: 8px 16px;"
                               onmouseover="this.style.color='#00f0ff'" onmouseout="this.style.color='#ffffff'">
                                View/Add Region
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Clerk" asp-action="SubRegions"
                               style="color: #ffffff; font-weight: 500; transition: color 0.3s ease; padding: 8px 16px;"
                               onmouseover="this.style.color='#00f0ff'" onmouseout="this.style.color='#ffffff'">
                                View SubRegions
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Clerk" asp-action="Citezens"
                               style="color: #ffffff; font-weight: 500; transition: color 0.3s ease; padding: 8px 16px;"
                               onmouseover="this.style.color='#00f0ff'" onmouseout="this.style.color='#ffffff'">
                                View/Add Citizens
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>
    <div >
        <main role="main">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
