@using System.Globalization
@model IEnumerable<SmartWater_Backend_Mvc.Models.Sub_Region>

@{
    ViewData["Title"] = "SubRegions";
    Layout = "_ClerkLayout";
}

<h1 style="color:white; margin:10px; font-size: 24px;">SubRegions</h1>

<div class="d-flex flex-wrap align-items-center gap-3 m-3 p-3 rounded" style="background-color: #1e1e24; border: 1px solid #333;">
    <div>
        <input type="text" id="tableSearch" placeholder="Search SubRegion..." class="form-control"
               style="background-color: #121212; color: #fff; border: 1px solid #00f0ff; max-width: 250px;" />
    </div>

    <div class="ms-auto d-flex align-items-center gap-3">
        <div class="d-flex flex-column align-items-end">
            <button id="downloadBtn" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 8px 16px; width:300px">
                📥 Download Filtered SubRegions
            </button>
           
        </div>
    </div>
</div>

<div style="height:100vh" class="table-responsive rounded shadow">
    <table id="reportsTable" style="margin:15px; border-radius:10px;" class="table table-dark table-hover mb-0">
        <thead style="border-bottom: 2px solid #00f0ff; margin:5px; background-color:#121212;">
            <tr>
                <th scope="col" class="text-white-50">SubRegion Name</th>
                <th scope="col" class="text-white-50">Meter Number</th>
                <th scope="col" class="text-white-50">Region Name</th>
                <th scope="col" class="text-white-50">Add Citezen</th>
                <th scope="col" class="text-white-50">Edit</th>
                <th scope="col" class="text-white-50">Delete</th>
            </tr>
        </thead>
        <tbody id="subRegionsTableBody">
            @foreach (var region in Model)
            {
                <tr class="subregion-row"
                    data-subname="@region.SubRegionName?.ToLower()"
                    data-meter="@region.Meter_Number?.ToLower()"
                    data-regname="@region.Region_Name?.ToLower()">
                    <td class="subname-cell text-white">@region.SubRegionName</td>
                    <td class="meter-cell text-white">@region.Meter_Number</td>
                    <td class="regname-cell text-white">@region.Region_Name</td>
                    <td><a asp-action="AddCitezens" asp-route-id="@region.Id" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">Add Citezen</a></td>
                    <td><a asp-action="EditSubRegion" asp-route-id="@region.Id" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">Edit</a></td>
                    <td><a asp-action="DeleteSubRegion" asp-route-id="@region.Id" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("tableSearch");
        const tableBody = document.getElementById("subRegionsTableBody");
        const downloadBtn = document.getElementById("downloadBtn");

        function filterTable() {
            const searchQuery = searchInput.value.toLowerCase().trim();
            const rows = tableBody.querySelectorAll(".subregion-row");

            rows.forEach(row => {
                const subName = row.dataset.subname || "";
                const meter = row.dataset.meter || "";
                const regName = row.dataset.regname || "";

                const textMatch = !searchQuery ||
                    subName.includes(searchQuery) ||
                    meter.includes(searchQuery) ||
                    regName.includes(searchQuery);

                if (textMatch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function downloadCSV() {
            let csv = [];
            csv.push("SubRegion Name,Meter Number,Region Name");

            const visibleRows = Array.from(tableBody.querySelectorAll(".subregion-row")).filter(row => row.style.display !== "none");

            visibleRows.forEach(row => {
                const subName = row.querySelector(".subname-cell").textContent.trim();
                const meter = row.querySelector(".meter-cell").textContent.trim();
                const regName = row.querySelector(".regname-cell").textContent.trim();

                csv.push(`"${subName}","${meter}","${regName}"`);
            });

            const csvContent = "\uFEFF" + csv.join("\n");
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const link = document.createElement("a");

            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", "SmartWater_SubRegions_Report.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        searchInput.addEventListener("input", filterTable);
        downloadBtn.addEventListener("click", downloadCSV);
    });
</script>