@model SmartWater_Backend_Mvc.Models.Sub_Region

@{
    ViewData["Title"] = "Add SubRegion";
    Layout = "_ClerkLayout";
}
<form asp-action="AddSubRegion" method="post">
    <div class="my-container">
        <div class="my-form">
            <h1>Add SubRegion</h1>
            <div class="my-inputs-div">
                <label>SubRegion Name</label>
                <input asp-for="SubRegionName" placeholder="SubRegion Name" type="text" />
            </div>
            <div class="my-inputs-div">
                <label>Meter Number</label>
                <input asp-for="Meter_Number" placeholder="Meter Number" type="text" />
            </div>
            <div class="my-inputs-div">
                <label>Region Name</label>
                <input asp-for="Region_Name" placeholder="Region Name" type="text" />
            </div>
            <button type="submit">Add SubRegion</button>
            <input type="hidden" asp-for="RegionId" />
            <span style="color:white">@ViewData["Message"]</span>
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
    </div>
</form>