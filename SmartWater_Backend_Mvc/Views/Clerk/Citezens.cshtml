@model IEnumerable<SmartWater_Backend_Mvc.Models.Owner>

@{
    ViewData["Title"] = "Account Management";
    Layout = "_ClerkLayout";
}

<div class="d-flex flex-wrap gap-3 m-3 align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
        <h2 class="text-white my-0 fw-bold">Account Payment Statuses of Citezens</h2>
    </div>
    <div style="margin:10px;align-items: center;justify-content: space-between;">
        <a id="downloadFilteredReport" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">
            Download Filtered Citezens (CSV)
        </a>
    </div>
</div>

<div class="m-3 p-3 rounded" style="background-color: #1e1e24; border: 1px solid #333;">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="text-white-50 small fw-bold text-uppercase mb-1 d-block">Search Accounts</label>
            <input type="text" id="tableSearch" class="form-control bg-dark text-white border-secondary" placeholder="Search by name, account or contact...">
        </div>
        <div class="col-md-3">
            <label class="text-white-50 small fw-bold text-uppercase mb-1 d-block">Filter By Status</label>
            <select id="statusFilter" class="form-select bg-dark text-white border-secondary">
                <option value="">All Statuses</option>
                <option value="Paid">Paid Only</option>
                <option value="Unpaid">Unpaid Only</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="text-white-50 small fw-bold text-uppercase mb-1 d-block">Sort Balances</label>
            <select id="debtSorter" class="form-select bg-dark text-white border-secondary">
                <option value="default">Default</option>
                <option value="highest">Highest Debt First</option>
                <option value="lowest">Lowest Debt First</option>
            </select>
        </div>
    </div>

    <div class="table-responsive rounded shadow">
        <table class="table table-dark table-hover mb-0" id="ownersTable">
            <thead style="border-bottom: 2px solid #333; background-color:#121212;">
                <tr>
                    <th class="text-white-50">Name</th>
                    <th class="text-white-50">Meter Number</th>
                    <th class="text-white-50">Account Number</th>
                    <th class="text-white-50">Contact Details</th>
                    <th class="text-white-50">Sub-Region</th>
                    <th class="text-white-50 text-center">Edit Citezen</th>
                    <th class="text-white-50 text-center">Delete Citezen</th>
                </tr>
            </thead>
            <tbody id="ownersTableBody">
                @foreach (var owner in Model)
                {
                    <tr class="owner-row"
                        data-name="@owner.OwnerName?.ToLower()"
                        data-account="@owner.Account_Number?.ToLower()"
                        data-email="@owner.Email?.ToLower()"
                        data-phone="@owner.Phone"
                        data-region="@owner.SubRegionName"
                        data-balance="@owner.OutstandingBalance"
                        data-status="@(owner.IsPaid ? "Paid" : "Unpaid")">
                        <td class="text-white name-cell">@owner.OwnerName</td>
                        <td class="fw-bold text-white id-cell">@owner.Meter_Number</td>
                        <td class="text-info fw-bold account-cell">ACC @owner.Account_Number</td>
                        <td>
                            <span class="d-block text-white phone-cell">@owner.Phone</span>
                            <small class="text-white-50 email-cell">@owner.Email</small>
                        </td>
                        <td class="text-white region-cell">@owner.SubRegionName</td>
                       
                        <td><a asp-action="EditCitezens" asp-route-id="@owner.OwnerId_Number" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">Edit</a></td>
                        <td><a asp-action="EditCitezens" asp-route-id="@owner.OwnerId_Number" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">Delete</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("tableSearch");
        const statusFilter = document.getElementById("statusFilter");
        const debtSorter = document.getElementById("debtSorter");
        const tableBody = document.getElementById("ownersTableBody");
        const downloadBtn = document.getElementById("downloadFilteredReport");

        function filterAndSortTable() {
            const searchQuery = searchInput.value.toLowerCase();
            const selectedStatus = statusFilter.value;
            const sortOrder = debtSorter.value;

            let rows = Array.from(tableBody.querySelectorAll(".owner-row"));

            rows.forEach(row => {
                const textMatch = !searchQuery ||
                    (row.dataset.name && row.dataset.name.includes(searchQuery)) ||
                    (row.dataset.account && row.dataset.account.includes(searchQuery)) ||
                    (row.dataset.email && row.dataset.email.includes(searchQuery)) ||
                    (row.dataset.phone && row.dataset.phone.includes(searchQuery));

                const statusMatch = !selectedStatus || row.dataset.status === selectedStatus;

                if (textMatch && statusMatch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });

            if (sortOrder === "highest") {
                rows.sort((a, b) => parseFloat(b.dataset.balance || 0) - parseFloat(a.dataset.balance || 0));
            } else if (sortOrder === "lowest") {
                rows.sort((a, b) => parseFloat(a.dataset.balance || 0) - parseFloat(b.dataset.balance || 0));
            }

            rows.forEach(row => tableBody.appendChild(row));
        }

        function downloadCSV() {
            let csv = [];
            csv.push("Meter Number,Name,Account Number,Phone,Email,Sub-Region,Outstanding Balance,Status");

            const visibleRows = Array.from(tableBody.querySelectorAll(".owner-row")).filter(row => row.style.display !== "none");

            visibleRows.forEach(row => {
                const id = row.querySelector(".id-cell").textContent.trim();
                const name = row.querySelector(".name-cell").textContent.trim();
                const account = row.querySelector(".account-cell").textContent.trim();
                const phone = row.querySelector(".phone-cell").textContent.trim();
                const email = row.querySelector(".email-cell").textContent.trim();
                const region = row.querySelector(".region-cell").textContent.trim();
                const balance = row.querySelector(".balance-cell").dataset.val;
                const status = row.dataset.status;

                csv.push(`"${id}","${name}","${account}","${phone}","${email}","${region}","R${parseFloat(balance).toFixed(2)}","${status}"`);
            });

            const csvContent = "\uFEFF" + csv.join("\n");
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const link = document.createElement("a");

            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", "SmartWater_Filtered_Owners_Report.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        searchInput.addEventListener("input", filterAndSortTable);
        statusFilter.addEventListener("change", filterAndSortTable);
        debtSorter.addEventListener("change", filterAndSortTable);
        downloadBtn.addEventListener("click", downloadCSV);
    });
</script>