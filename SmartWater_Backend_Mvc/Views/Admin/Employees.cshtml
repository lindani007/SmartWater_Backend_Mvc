@model IEnumerable<SmartWater_Backend_Mvc.Models.Employee>

@{
    ViewData["Title"] = "Employees";
    Layout = "_adminLayout";
}

<div class="d-flex flex-wrap gap-3 m-3 align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
        <h2 class="text-white my-0 fw-bold">Employees</h2>
    </div>
    <div style="margin:10px; align-items: center; justify-content: space-between;">
        <a asp-action="AddEmployee" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">
            Add New Employee
        </a>
        <a id="downloadFilteredReport" class="btn fw-bold shadow-sm" style="background-color: #00f0ff; color: #121212; border-radius: 8px; padding: 10px 20px; text-decoration: none; display: inline-block; transition: all 0.2s;">
            Download Filtered Employees (CSV)
        </a>
    </div>
</div>

<div class="m-3 p-3 rounded" style="background-color: #1e1e24; border: 1px solid #333;">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="text-white-50 small fw-bold text-uppercase mb-1 d-block">Search Employee</label>
            <input type="text" id="tableSearch" class="form-control bg-dark text-white border-secondary" placeholder="Search by name, account or contact...">
        </div>
        <div class="col-md-3">
            <label class="text-white-50 small fw-bold text-uppercase mb-1 d-block">Filter By Role</label>
            <select id="statusFilter" class="form-select bg-dark text-white border-secondary">
                <option value="">All Roles</option>
                <option value="clerk">Clerk</option>
                <option value="finance">Finance</option>
                <option value="engineer">Engineer</option>
                <option value="admin">Admin</option>
            </select>
        </div>
    </div>

    <div class="table-responsive rounded shadow">
        <table class="table table-dark table-hover mb-0" id="ownersTable">
            <thead style="border-bottom: 2px solid #333; background-color:#121212;">
                <tr>
                    <th class="text-white-50">Employee Number</th>
                    <th class="text-white-50">Full Names</th>
                    <th class="text-white-50">Address</th>
                    <th class="text-white-50">Contact Details</th>
                    <th class="text-white-50">Role</th>
                    <th class="text-white-50">Id Number</th>
                    <th class="text-white-50 text-center">Edit Employee</th>
                    <th class="text-white-50 text-center">Delete Employee</th>
                </tr>
            </thead>
            <tbody id="ownersTableBody">
                @foreach (var owner in Model)
                {
                    <tr class="owner-row"
                        data-number="@owner.Employer_Number?.ToLower()"
                        data-name="@owner.Employee_FullNames?.ToLower()"
                        data-email="@owner.Employer_Email?.ToLower()"
                        data-phone="@owner.Employer_PhoneNumber"
                        data-address="@owner.Employee_Address?.ToLower()"
                        data-role="@owner.Employer_Role?.ToLower()"
                        data-idnumber="@owner.Employer_IdNumber">
                        <td class="text-white number-cell">@owner.Employer_Number</td>
                        <td class="fw-bold text-white name-cell">@owner.Employee_FullNames</td>
                        <td class="text-info fw-bold address-cell">@owner.Employee_Address</td>
                        <td>
                            <span class="d-block text-white phone-cell">@owner.Employer_PhoneNumber</span>
                            <small class="text-white-50 email-cell">@owner.Employer_Email</small>
                        </td>
                        <td class="text-white role-cell">@owner.Employer_Role</td>
                        <td class="idnumber-cell">@owner.Employer_IdNumber</td>
                        <td class="text-center"><a asp-action="EditEmployee" asp-route-id="@owner.Employer_Number">Edit</a></td>
                        <td class="text-center"><a asp-action="DeleteEmployee" asp-route-id="@owner.Employer_Number">Delete</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("tableSearch");
        const statusFilter = document.getElementById("statusFilter");
        const tableBody = document.getElementById("ownersTableBody");
        const downloadBtn = document.getElementById("downloadFilteredReport");

        function filterTable() {
            const searchQuery = searchInput.value.toLowerCase().trim();
            const selectedRole = statusFilter.value;

            let rows = tableBody.querySelectorAll(".owner-row");

            rows.forEach(row => {
                const textMatch = !searchQuery ||
                    (row.dataset.number && row.dataset.number.includes(searchQuery)) ||
                    (row.dataset.name && row.dataset.name.includes(searchQuery)) ||
                    (row.dataset.email && row.dataset.email.includes(searchQuery)) ||
                    (row.dataset.phone && row.dataset.phone.includes(searchQuery));

                const roleMatch = !selectedRole || (row.dataset.role && row.dataset.role.includes(selectedRole));

                if (textMatch && roleMatch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function downloadCSV() {
            let csv = [];
            csv.push("Employee Number,Full Names,Address,Phone,Email,Role,Id Number");

            const visibleRows = Array.from(tableBody.querySelectorAll(".owner-row")).filter(row => row.style.display !== "none");

            visibleRows.forEach(row => {
                const number = row.querySelector(".number-cell").textContent.trim();
                const name = row.querySelector(".name-cell").textContent.trim();
                const address = row.querySelector(".address-cell").textContent.trim();
                const phone = row.querySelector(".phone-cell").textContent.trim();
                const email = row.querySelector(".email-cell").textContent.trim();
                const role = row.querySelector(".role-cell").textContent.trim();
                const idNumber = row.querySelector(".idnumber-cell").textContent.trim();

                csv.push(`"${number}","${name}","${address}","${phone}","${email}","${role}","${idNumber}"`);
            });

            const csvContent = "\uFEFF" + csv.join("\n");
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const link = document.createElement("a");

            link.href = URL.createObjectURL(blob);
            link.setAttribute("download", "SmartWater_Filtered_Employees_Report.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        searchInput.addEventListener("input", filterTable);
        statusFilter.addEventListener("change", filterTable);
        downloadBtn.addEventListener("click", downloadCSV);
    });
</script>