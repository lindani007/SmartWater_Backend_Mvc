@model SmartWater_Backend_Mvc.Models.ChangePassword

@{
    ViewData["Title"] = "Change Password";
    Layout = "_AccountLayout";
}

<form action="ChangePassword" method="post">

    <div class="my-container">
        <div class="my-form">
           <h1 style="color:white">Change Password</h1>
            <div class="my-inputs-div">
                <label>Password</label>
                <input asp-for="Password" placeholder="Password" type="password" />
            </div>
            <div class="my-inputs-div">
                <label>Confirm Password</label>
                <input type="password" asp-for="ConfirmPassword" placeholder="Confirm Password" />
            </div>
            <button type="submit" style="width:170px">Change Password</button>
            <span style="color:white">@ViewData["Message"]</span>
            <input asp-for="Stuff_Id" type="hidden" />
        </div>
    </div>
</form>
