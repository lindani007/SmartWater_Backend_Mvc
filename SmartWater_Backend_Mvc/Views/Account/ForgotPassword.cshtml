@model SmartWater_Backend_Mvc.Models.Login

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AccountLayout";
}

<form action="ForgotPassword" method="post">

    <div class="my-container">
        <div class="my-form">
            <h1 style="color:white">Forgot Password</h1>
            <div class="my-inputs-div">
                <label>Staff ID</label>
                <input asp-for="Stuff_Id" placeholder="Stuff Id" type="text" />
            </div>
            <div class="my-inputs-div">
                <label>Email</label>
                <input asp-for="Email" placeholder="Email" type="email" />
            </div>
            <button type="submit">Send Code</button>
            <span style="color:white">@ViewData["Message"]</span>
        </div>
    </div>
</form>