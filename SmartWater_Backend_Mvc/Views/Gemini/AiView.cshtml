@model List<ChatMessage>

@{
    int activeChatId = ViewBag.ActiveChatId ?? 0;
    var activeChat = Model?.FirstOrDefault(x => x.ChatId == activeChatId) ?? Model?.FirstOrDefault();
    var activeMessages = activeChat?.Message ?? new List<MyMessage>();
}

<div id="aiViewContainer" class="chat-container">

    <div class="chat-header" style="display: flex; justify-content: space-between; align-items: center; width: 90%;">
        <div>
            <div class="title">✨ Drop Wise Intelligence</div>
            <small>Analysis Assistant</small>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a asp-action="AdminDashboard" asp-controller="Admin"
               class="btn btn-outline-light"
               style="background-color: #0d6efd; color: #ffffff; border: 1px solid #0d6efd; padding: 8px 20px; border-radius: 6px; font-weight: 500; text-decoration: none; transition: all 0.2s ease-in-out;">
                Back to Dashboard
            </a>
        </div>
    </div>

    <div class="chat-workspace">

        <aside class="chat-sidebar">

            <div class="sidebar-header">
                <h4>Conversations</h4>
            </div>

            <div class="new-chat-container">
                <button type="button" class="new-chat-button" onclick="handleNewChat()">
                    + New Chat
                </button>
            </div>

            <div class="conversation-search">
                <input type="text"
                       id="conversationSearch"
                       placeholder="🔍 Search conversations..." />
            </div>

            <div id="conversationList" class="conversation-list">

                @if (Model != null && Model.Any(x => x.ChatId > 0))
                {
                    foreach (var chat in Model.Where(x => x.ChatId > 0).OrderByDescending(x => x.Timestamp))
                    {
                        <div class="conversation-item @(chat.ChatId == activeChatId ? "active" : "")"
                             data-chat-id="@chat.ChatId"
                             onclick="selectConversation('@chat.ChatId')">

                            <div class="conversation-icon">
                                💧
                            </div>

                            <div class="conversation-details">
                                <div class="conversation-title">
                                    @chat.ChatTitle
                                </div>

                                <div class="conversation-date">
                                    @chat.Timestamp.ToString("dd MMM yyyy")
                                </div>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-conversations">
                        No previous conversations
                    </div>
                }

            </div>

        </aside>

        <main class="chat-main">

            <div id="chat-thread-container" class="chat-thread">

                @foreach (var item in activeMessages)
                {
                    if (string.IsNullOrWhiteSpace(item.Message))
                    {
                        continue;
                    }

                    if (item.IsUser)
                    {
                        <div class="message user">
                            <div class="bubble">
                                @item.Message
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="message ai">
                            <div class="avatar">✨</div>
                            <div class="bubble ai-bubble">
                                <div class="bubble-title">Drop Wise Ai</div>
                                <div class="markdown-body ai-markdown-msg">@item.Message.Trim()</div>
                            </div>
                        </div>
                    }
                }

                <!-- Thinking Skeleton Indicator -->
                <div id="aiThinkingMessage" class="message ai thinking-skeleton" style="display: none;">
                    <div class="avatar">✨</div>
                    <div class="bubble ai-bubble">
                        <div class="bubble-title">Drop Wise Ai</div>
                        <div class="skeleton-content">
                            <div class="skeleton-line full"></div>
                            <div class="skeleton-line half"></div>
                            <small id="thinkingStatus" class="thinking-text">Analyzing your request...</small>
                        </div>
                    </div>
                </div>

            </div>

            <form id="aiPromptForm"
                  asp-action="QueryDatabasePrompt"
                  method="get"
                  class="chat-input">

                <input type="hidden" name="chatId" value="@activeChatId" />

                <div class="chat-input-wrapper">
                    <input class="form-control"
                           id="userPromptInput"
                           name="prompt"
                           placeholder="Ask Drop Wise Ai anything related to consumptions..."
                           required />

                    <button type="submit"
                            id="sendButton"
                            class="btn btn-info px-4">
                        Send
                    </button>
                </div>

            </form>

        </main>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
    (() => {
        initializeAiView();
    })();

    function initializeAiView() {
        document.querySelectorAll(".ai-markdown-msg").forEach((el) => {
            const rawText = (el.textContent || el.innerText || "").trim();
            if (typeof marked !== "undefined" && rawText) {
                el.innerHTML = marked.parse(rawText);
            }
        });

        scrollChatToBottom();

        document.getElementById("userPromptInput")?.focus();

        const form = document.getElementById("aiPromptForm");
        if (form) {
            form.addEventListener("submit", handleAiSubmit);
        }

        const searchInput = document.getElementById("conversationSearch");
        if (searchInput) {
            searchInput.addEventListener("input", handleSearchConversations);
        }
    }

    function handleNewChat() {
        window.location.href = "/Gemini/DropWiseAi";
    }

    function selectConversation(chatId) {
        window.location.href = `/Gemini/DropWiseAi?chatId=${chatId}`;
    }

    function handleSearchConversations(e) {
        const query = e.target.value.toLowerCase().trim();
        const items = document.querySelectorAll(".conversation-item");

        items.forEach((item) => {
            const title = item.querySelector(".conversation-title")?.textContent.toLowerCase() || "";
            if (title.includes(query)) {
                item.style.display = "flex";
            } else {
                item.style.display = "none";
            }
        });
    }

    async function handleAiSubmit(event) {
        event.preventDefault();

        const form = event.target;
        const input = document.getElementById("userPromptInput");
        const sendButton = document.getElementById("sendButton");
        const thread = document.getElementById("chat-thread-container");
        const thinkingMessage = document.getElementById("aiThinkingMessage");
        const statusElement = document.getElementById("thinkingStatus");

        const prompt = input.value.trim();
        if (!prompt) return;

        // Capture form data before clearing the input field
        const formData = new FormData(form);

        sendButton.disabled = true;
        sendButton.classList.add("ai-processing");
        sendButton.innerHTML = "Processing...";

        const userMessage = document.createElement("div");
        userMessage.className = "message user";
        userMessage.innerHTML = `
            <div class="bubble">
                ${escapeHtml(prompt)}
            </div>
        `;

        if (thinkingMessage) {
            thread.insertBefore(userMessage, thinkingMessage);
        } else {
            thread.appendChild(userMessage);
        }

        // Clear input field now that FormData has saved the prompt
        input.value = "";

        if (thinkingMessage) {
            thinkingMessage.style.display = "flex";
        }

        scrollChatToBottom();

        const statuses = [
            "Analyzing your request",
            "Processing consumption data",
            "Evaluating hydraulic patterns",
            "Preparing your analysis"
        ];
        let statusIndex = 0;
        const statusInterval = setInterval(() => {
            statusIndex = (statusIndex + 1) % statuses.length;
            if (statusElement) {
                statusElement.textContent = statuses[statusIndex] + "...";
            }
        }, 2500);

        try {
            const params = new URLSearchParams(formData).toString();
            const url = form.action + "?" + params;

            const response = await fetch(url, {
                method: "GET",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (!response.ok) {
                throw new Error(`Server returned ${response.status}`);
            }

            const html = await response.text();
            clearInterval(statusInterval);

            const parser = new DOMParser();
            const newDocument = parser.parseFromString(html, "text/html");
            const newContainer = newDocument.querySelector("#aiViewContainer");

            if (newContainer) {
                document.getElementById("aiViewContainer").replaceWith(
                    document.importNode(newContainer, true)
                );
            }

            initializeAiView();
        }
        catch (error) {
            clearInterval(statusInterval);
            if (thinkingMessage) thinkingMessage.style.display = "none";

            const errorMessage = document.createElement("div");
            errorMessage.className = "message ai";
            errorMessage.innerHTML = `
                <div class="avatar">✨</div>
                <div class="bubble ai-bubble">
                    <div class="bubble-title">Drop Wise Ai</div>
                    <div class="markdown-body">
                        ❌ Error processing request.
                        <br><br>
                        <small>${escapeHtml(error.message)}</small>
                    </div>
                </div>
            `;
            thread.appendChild(errorMessage);
            scrollChatToBottom();

            sendButton.disabled = false;
            sendButton.classList.remove("ai-processing");
            sendButton.innerHTML = "Send";
            input.focus();
        }
    }

    function scrollChatToBottom() {
        const thread = document.getElementById("chat-thread-container");
        if (thread) {
            thread.scrollTop = thread.scrollHeight;
        }
    }

    function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
    }
</script>

