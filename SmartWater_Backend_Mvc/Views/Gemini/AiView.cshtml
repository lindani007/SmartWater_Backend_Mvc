@model List<ChatMessage>

<div id="aiViewContainer" class="chat-container">

    <div class="chat-header">
        <div>
            <div class="title">✨ Gemini Intelligence</div>
            <small>Analysis Assistant</small>
        </div>
    </div>

    <div id="chat-thread-container" class="chat-thread">
        @foreach (var item in Model)
        {
            if (item.IsUser)
            {
                <div class="message user">
                    <div class="bubble">
                        @item.Message
                    </div>
                </div>
            }
            else
            {
                <div class="message ai">
                    <div class="avatar">✨</div>

                    <div class="bubble ai-bubble">
                        <div class="bubble-title">
                            Gemini
                        </div>

                        <!-- Raw message container converted by JavaScript markdown compiler below -->
                        <div class="markdown-body ai-markdown-msg">@item.Message</div>
                    </div>
                </div>
            }
        }
    </div>

    <form asp-action="QueryDatabasePrompt" method="get" class="chat-input">
        <div class="chat-input-wrapper">
            <input class="form-control"
                   id="userPromptInput"
                   name="prompt"
                   placeholder="Ask Gemini anything related to consumptions..."
                   required />

            <button type="submit" class="btn btn-info px-4">
                Send
            </button>
        </div>
    </form>
</div>

<form id="exportForm" method="post" style="display:none">
    <input id="exportContent" name="conversationLog" type="hidden" />
    <input id="exportType" name="analysisType" value="@ViewBag.AnalysisType" type="hidden" />
</form>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    (() => {
        // Find all elements marked for AI responses and apply Markdown layout parser rules
        document.querySelectorAll(".ai-markdown-msg").forEach((el) => {
            const rawText = el.textContent || el.innerText;
            if (typeof marked !== 'undefined' && rawText) {
                el.innerHTML = marked.parse(rawText);
            }
        });

        // Pin current viewport view lock context exactly at the bottom text line
        const thread = document.getElementById("chat-thread-container");
        if (thread) {
            thread.scrollTop = thread.scrollHeight;
        }

        // Return workspace focus directly inside text editing input region
        document.getElementById("userPromptInput")?.focus();
    })();

    function closeAiModal() {
        document.getElementById("aiViewContainer").remove();
    }

    function exportAiChat(type) {
        document.getElementById("exportContent").value =
            document.getElementById("chat-thread-container").innerText;

        let form = document.getElementById("exportForm");
        form.action = "/AiAnalysis/ExportChatTo" + type.toUpperCase();
        form.submit();
    }
</script>

<style>
    body {
        background: #0f1117;
        color: #fff;
        font-family: "Segoe UI",sans-serif;
    }

    /* ===========================
           Main Container
        =========================== */
    .chat-container {
        background: #0f1117;
        border: 1px solid #2b313d;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,.45);
    }

    /* ===========================
           Header
        =========================== */
    .chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 25px;
        background: #161b22;
        border-bottom: 1px solid #2b313d;
    }

    .title {
        color: #29d9ff;
        font-size: 20px;
        font-weight: 700;
    }

    .chat-header small {
        color: #9098a4;
        font-size: 13px;
    }

    /* ===========================
           Conversation Area
        =========================== */
    .chat-thread {
        height: 65vh;
        overflow-y: auto;
        padding: 35px;
        background: #0f1117;
        scroll-behavior: smooth;
    }

    /* ===========================
           Messages
        =========================== */
    .message {
        display: flex;
        align-items: flex-start;
        margin-bottom: 30px;
    }

    .user {
        justify-content: flex-end;
    }

    .avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #27d8ff;
        color: #000;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 18px;
        margin-right: 15px;
        flex-shrink: 0;
    }

    /* ===========================
           Chat Bubbles
        =========================== */
    .bubble {
        max-width: 75%;
        min-width: 350px;
        padding: 25px;
        border-radius: 18px;
        word-wrap: break-word;
    }

    .ai-bubble {
        background: #181d25;
        border: 1px solid #323b48;
    }

    .user .bubble {
        background: #0d6efd;
        color: #fff;
    }

    .bubble-title {
        font-size: 17px;
        font-weight: 700;
        color: #29d9ff;
        margin-bottom: 18px;
    }

    /* ===========================
           Markdown
        =========================== */
    .markdown-body {
        color: #d9e2ef;
        font-size: 17px;
        line-height: 1.9;
    }

        .markdown-body h1,
        .markdown-body h2,
        .markdown-body h3 {
            color: #29d9ff;
            margin-top: 30px;
            margin-bottom: 18px;
            font-weight: 700;
        }

        .markdown-body h1 {
            font-size: 28px;
        }

        .markdown-body h2 {
            font-size: 23px;
        }

        .markdown-body h3 {
            font-size: 20px;
        }

        .markdown-body p {
            margin-bottom: 18px;
        }

        .markdown-body ul,
        .markdown-body ol {
            padding-left: 25px;
            margin-bottom: 18px;
        }

        .markdown-body li {
            margin-bottom: 10px;
        }

        .markdown-body strong {
            color: #fff;
        }

        .markdown-body code {
            background: #202733;
            padding: 2px 6px;
            border-radius: 5px;
        }

        .markdown-body pre {
            background: #161b22;
            padding: 18px;
            border-radius: 12px;
            overflow: auto;
        }

    /* ===========================
           Input Area
        =========================== */
    .chat-input {
        display: flex;
        justify-content: center;
        padding: 22px;
        background: #161b22;
        border-top: 1px solid #2b313d;
    }

    .chat-input-wrapper {
        width: 100%;
        max-width: 900px;
        display: flex;
        gap: 12px;
    }

    .chat-input input {
        flex: 1;
        height: 58px;
        border: none;
        border-radius: 30px;
        background: #1f2530;
        color: #fff;
        padding: 0 22px;
        font-size: 16px;
    }

        .chat-input input::placeholder {
            color: #9ea8b8;
        }

        .chat-input input:focus {
            outline: none;
            box-shadow: none;
            background: #252d39;
            color: #fff;
        }

    .chat-input button {
        height: 58px;
        min-width: 110px;
        border-radius: 30px;
        font-weight: 600;
    }

    /* ===========================
           Buttons
        =========================== */
    .btn-outline-info,
    .btn-outline-success,
    .btn-outline-light {
        border-radius: 8px;
    }

    /* ===========================
           Scrollbar
        =========================== */
    .chat-thread::-webkit-scrollbar {
        width: 8px;
    }

    .chat-thread::-webkit-scrollbar-track {
        background: #131821;
    }

    .chat-thread::-webkit-scrollbar-thumb {
        background: #3a4555;
        border-radius: 10px;
    }

        .chat-thread::-webkit-scrollbar-thumb:hover {
            background: #566377;
        }

    @@media(max-width:768px) {
        .chat-thread {
            padding: 20px;
        }

        .bubble {
            max-width: 100%;
            min-width: unset;
        }

        .chat-input-wrapper {
            max-width: 100%;
        }

        .chat-header {
            padding: 15px;
        }

        .title {
            font-size: 17px;
        }

        .markdown-body {
            font-size: 15px;
        }
    }
</style>