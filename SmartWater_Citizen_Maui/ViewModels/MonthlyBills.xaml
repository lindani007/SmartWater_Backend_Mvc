<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartWater_Citizen_Maui.ViewModels.MonthlyBills"
             xmlns:viemodel="clr-namespace:SmartWater_Citizen_Maui.ViewModels"
             xmlns:vm="clr-namespace:SmartWater_Citizen_Maui.Models"
             Title="MonthlyBills" x:DataType="viemodel:BillingHistorySummary" BackgroundColor="Black">
    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="15" Spacing="5">
            <Label Text="{Binding Billing_Month, StringFormat='Usage Details: {0}'}" TextColor="#29ede7" FontSize="20" FontAttributes="Bold"/>
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
                <Border Padding="12" Margin="4"  WidthRequest="180" HeightRequest="100" BackgroundColor="#29ede7">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Opacity="10" Brush="Black" Offset="5,5" Radius="8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="10">
                        <Label Text="Total Water" TextColor="Black" FontAttributes="Bold" />
                        <Label Text="{Binding Total_Water_Liters, StringFormat='{0:N1}L'}" TextColor="Black" FontSize="24" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="12" Margin="4" WidthRequest="180" HeightRequest="100" BackgroundColor="#29ede7">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Opacity="10" Brush="Black" Offset="5,5" Radius="8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Padding="10">
                        <Label Text="Total Cost:" FontAttributes="Bold" TextColor="Black"/>
                        <Label Text="{Binding Total_Cost_Rands, StringFormat='R{0:F2}'}" FontSize="24" TextColor="Black"/>
                    </VerticalStackLayout>
                </Border>
            </StackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Margin="0,10,0,0">
            <VerticalStackLayout Padding="15" Spacing="2">
                <Grid BackgroundColor="#29ede7" Padding="10,8" ColumnDefinitions="2*,*,*">
                    <Label Grid.Column="0" Text="Appliance" TextColor="Black" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="Liters" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Grid.Column="2" Text="Cost" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center"/>
                </Grid>

                <CollectionView ItemsSource="{Binding RawDailyLogs}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApplienceCosumption">
                            <Grid Padding="10,12" ColumnDefinitions="2*,*,*" BackgroundColor="#111">
                                <Label Grid.Column="0" Text="{Binding Appliance_Name}" TextColor="White" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Applience_Water_Consumed, StringFormat='{0:N1} L'}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding Applience_Amount_Spent, StringFormat='R{0:F2}'}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>