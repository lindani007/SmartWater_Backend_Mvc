<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartWater_Citizen_Maui.Views.ForgotPassword"
             xmlns:vm="clr-namespace:SmartWater_Citizen_Maui.ViewModels"
             Title="ForgotPassword" x:DataType="vm:LoginViewModel" BackgroundColor="#121212">
    <ScrollView>
        <StackLayout VerticalOptions="Center">
            <Grid x:Name="EmailSection" IsVisible="{Binding IsVerifyEmailCanBeVisble}" VerticalOptions="Center">
                <StackLayout Spacing="10" Padding="10">
                    <Border Stroke="#05faeb" WidthRequest="{OnPlatform Android='300',iOS='300', Default='550'}" HeightRequest="300" Padding="10" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <StackLayout Spacing="10" VerticalOptions="Center">
                            <HorizontalStackLayout Margin="10" HorizontalOptions="Center">
                                <Label Text="Account Number" VerticalOptions="Center" TextColor="White" WidthRequest="{OnPlatform Android='90', iOS='90', Default='170'}" FontSize="{OnPlatform Android='11', iOS='11', Default='20'}"/>
                                <Border>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15"/>
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding AccountNumber}" TextColor="White" Placeholder="Account Number" WidthRequest="{OnPlatform Android='170', iOS='170', Default='270'}" HorizontalTextAlignment="Center"/>
                                </Border>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="10" HorizontalOptions="Center">
                            <Label Text="Email" TextColor="White" WidthRequest="{OnPlatform Android='80', iOS='80', Default='170'}" FontSize="20"/>
                            <Border Margin="5">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15"/>
                                </Border.StrokeShape>
                                <Entry TextColor="White" Text="{Binding Email}" Placeholder="Email" WidthRequest="{OnPlatform Android='170', iOS='170', Default='270'}" HorizontalTextAlignment="Center"/>
                            </Border>
                        </HorizontalStackLayout>

                        <Border WidthRequest="120">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Button Text="Send" Command="{Binding SendClickedCommand}" WidthRequest="120" BackgroundColor="#05faeb" />
                        </Border>
                        </StackLayout>
                        
                    </Border>
                </StackLayout>
            </Grid>
            <Grid x:Name="CodeScetion" IsVisible="{Binding IsVerifyCodeCanBeVisble}" VerticalOptions="Center">
                <StackLayout Spacing="10" Padding="10">
                    <Border Stroke="#05faeb" WidthRequest="{OnPlatform Android='300',iOS='300', Default='550'}" HeightRequest="200" Padding="10" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15"/>
                        </Border.StrokeShape>
                        <StackLayout Spacing="10" VerticalOptions="Center">
                            <HorizontalStackLayout Margin="10" HorizontalOptions="Center">
                                <Label Text="Code" TextColor="White" WidthRequest="{OnPlatform Android='80', iOS='80', Default='170'}" FontSize="20"/>
                                <Border>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="15"/>
                                    </Border.StrokeShape>
                                    <Entry TextColor="White" Text="{Binding Code}" Placeholder="Code" WidthRequest="{OnPlatform Android='170', iOS='170', Default='270'}" HorizontalTextAlignment="Center"/>
                                </Border>
                            </HorizontalStackLayout>

                            <Border WidthRequest="120">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15"/>
                                </Border.StrokeShape>
                                <Button Text="Verify" Command="{Binding VerfyClickedCommand}" WidthRequest="120" BackgroundColor="#05faeb" />
                            </Border>
                        </StackLayout>

                    </Border>
                </StackLayout>
            </Grid>
            <Grid x:Name="RegisterSection" IsVisible="{Binding IsChangePasswordCanBeVisble}">
                <Border Stroke="#05faeb" WidthRequest="{OnPlatform Android='300',iOS='300', Default='550'}" HeightRequest="240" Padding="10" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <StackLayout Spacing="10" Padding="10">
                        <HorizontalStackLayout Margin="10" HorizontalOptions="Center">
                            <Label Text="Password" VerticalOptions="Center" TextColor="White" WidthRequest="{OnPlatform Android='80', iOS='80', Default='170'}" FontSize="{OnPlatform Android='10', iOS='10', Default='20'}"/>
                            <Border>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding Password}"  TextColor="White" IsPassword="True" Placeholder="Password" WidthRequest="{OnPlatform Android='170', iOS='170', Default='270'}" HorizontalTextAlignment="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Margin="5" HorizontalOptions="Center">
                            <Label Text="Confirm Password" VerticalOptions="Center" TextColor="White" WidthRequest="{OnPlatform Android='90', iOS='90', Default='170'}" FontSize="{OnPlatform Android='10', iOS='10', Default='20'}"/>
                            <Border>
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding ConfirmPassword}" TextColor="White" IsPassword="True" Placeholder="Confirm Password" WidthRequest="{OnPlatform Android='170', iOS='170', Default='270'}" HorizontalTextAlignment="Center"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Border WidthRequest="120">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Button Text="Change" Command="{Binding ChangeClickedCommand}" WidthRequest="120" BackgroundColor="#05faeb" />
                        </Border>
                    </StackLayout>
                </Border>
            </Grid>
        </StackLayout>
    </ScrollView>
</ContentPage>