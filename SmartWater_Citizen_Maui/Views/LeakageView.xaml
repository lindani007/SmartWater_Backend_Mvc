<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartWater_Citizen_Maui.ViewModels"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="SmartWater_Citizen_Maui.Views.LeakageView"
             Title="LeakageView" BackgroundColor="Black" 
             x:DataType="viewmodels:LeakageViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="25">
            <Border StrokeThickness="0" BackgroundColor="#111">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*, *" Padding="15">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="5">
                        <Label Text="Water Received" TextColor="Gray" FontSize="16" HorizontalOptions="Center"/>
                        <Label Text="{Binding WaterReceivedKl, StringFormat='{0:N2} kL'}" TextColor="#29ede7" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                        <Label Text="Total Used" TextColor="Gray" FontSize="16" HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalWaterUsedKl, StringFormat='{0:N2} kL'}" TextColor="#29ede7" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Border StrokeThickness="0" BackgroundColor="#111" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Usage vs Loss Breakdown" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <microcharts:ChartView Chart="{Binding LeakagePieChart}" 
                                           HeightRequest="160" />

                    <Label Text="{Binding SummaryText}" TextColor="#ccc" FontSize="13" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Spacing="5">
                <Label Text="Current Appliance Breakdown" TextColor="White" FontSize="16" FontAttributes="Bold" Margin="0,0,0,5"/>
                <Grid BackgroundColor="#29ede7" Padding="10,8" ColumnDefinitions="2*,*,*,*">
                    <Label Grid.Column="0" Text="Appliance" TextColor="Black" FontAttributes="Bold" FontSize="12"/>
                    <Label Grid.Column="1" Text="Used (L)" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" FontSize="12"/>
                    <Label Grid.Column="2" Text="Usage %" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" FontSize="12"/>
                    <Label Grid.Column="3" Text="Leak %" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" FontSize="12"/>
                </Grid>
                <CollectionView ItemsSource="{Binding ApplianceUsages}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ApplianceLeakageDisplay">
                            <Grid Padding="10,12" ColumnDefinitions="2*,*,*,*" BackgroundColor="#111">
                                <Label Grid.Column="0" Text="{Binding ApplianceName}" TextColor="White" FontSize="13"/>
                                <Label Grid.Column="1" Text="{Binding WaterUsedLiters, StringFormat='{0:N1}'}" TextColor="White" HorizontalOptions="Center" FontSize="13"/>
                                <Label Grid.Column="2" Text="{Binding PercentOfTotalReceived, StringFormat='{0:N1}%'}" TextColor="#29ede7" HorizontalOptions="Center" FontSize="13"/>
                                <Label Grid.Column="3" Text="{Binding LeakagePercent, StringFormat='{0:N1}%'}" TextColor="Red" HorizontalOptions="Center" FontSize="13"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5">
                <Label Text="Consumption Comparison History" TextColor="White" FontSize="16" FontAttributes="Bold" Margin="0,0,0,5"/>
                <Grid BackgroundColor="#29ede7" Padding="10,8" ColumnDefinitions="1.5*,*,*">
                    <Label Grid.Column="0" Text="Month" TextColor="Black" FontAttributes="Bold" FontSize="12"/>
                    <Label Grid.Column="1" Text="Actual" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" FontSize="12"/>
                    <Label Grid.Column="2" Text="Predicted" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center" FontSize="12"/>
                </Grid>
                <CollectionView ItemsSource="{Binding HistoricalComparisons}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MonthComparisonDisplay">
                            <Grid Padding="10,10" ColumnDefinitions="1.5*,*,*" BackgroundColor="#111" Margin="0,1">
                                <Label Grid.Column="0" Text="{Binding MonthYear}" TextColor="White" VerticalOptions="Center" FontSize="13"/>
                                <Label Grid.Column="1" Text="{Binding ActualConsumptionKl, StringFormat='{0:N1} kL'}" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13"/>
                                <Label Grid.Column="2" Text="{Binding PredictedConsumptionKl, StringFormat='{0:N1} kL'}" TextColor="#29ede7" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Border StrokeThickness="1" Stroke="#29ede7" BackgroundColor="#111" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="✨ Do you wanna know your next month water consumption?" TextColor="#29ede7" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="*,*" Margin="0,5">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Predicted Volume" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                            <Label Text="{Binding PredictedNextMonthTotalKl, StringFormat='{0:N2} kL'}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Estimated Cost Budget" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                            <Label Text="{Binding PredictedNextMonthCost, StringFormat='R {0:N2}'}" TextColor="#29ede7" FontSize="16" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Line Stroke="Gray" StrokeThickness="0.5" X2="300" HorizontalOptions="Center" Margin="0,5"/>

                    <CollectionView ItemsSource="{Binding AppliancePredictions}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:AppliancePredictionDisplay">
                                <Grid Padding="5,6" ColumnDefinitions="2*,*,*">
                                    <Label Grid.Column="0" Text="{Binding ApplianceName}" TextColor="#ccc" FontSize="13" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding PredictedWaterKl, StringFormat='{0:N2} kL'}" TextColor="White" HorizontalOptions="Center" FontSize="13" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding PredictedCost, StringFormat='R {0:N2}'}" TextColor="#29ede7" HorizontalOptions="End" FontSize="13" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>